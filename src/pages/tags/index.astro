---
import Base from '../../layouts/Base.astro';
import { publicPosts, tagCounts, tagUrl } from '../../lib/posts';
const tags = tagCounts(await publicPosts());
---
<Base title="探索主题" active="tags">
  <header class="page-intro"><p class="eyebrow">FOLLOW YOUR CURIOSITY</p><h1>从一个问题，走向更多发现。</h1><p>按主题阅读，串起散落在文章里的知识。</p></header>
  <div class="topic-grid">{tags.map(([tag, count], index) => <a class="topic-card" href={tagUrl(tag)}><span class="topic-index">{String(index + 1).padStart(2, '0')} / TOPIC</span><h2><span>#</span> {tag}</h2><div><span>{count} 篇文章</span><span aria-hidden="true">↗</span></div></a>)}</div>
  {tags.length === 0 && <div class="empty-state"><p>发布带有标签的文章后，主题会出现在这里。</p></div>}
</Base>
